# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Runtime pid file written by ../run_frontend_082.sh so a restart can stop the
# previous server. `/.next/` above matches the directory only, so this was
# turning up as an untracked file in the PRODUCTION checkout on 082 — noise that
# a later session has to decide about. Kept in place rather than moved to /tmp:
# the running instance is only stoppable via the path it was recorded under.
/.next-server-*.pid

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
