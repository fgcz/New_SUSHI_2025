# Application
ENVIRONMENT=local  # local, staging, production

# SQLite Database
DATABASE_PATH=storage/development.sqlite3

# LDAP
LDAP_HOST=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
